{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DadaDuck",
  "version": "0.3.1",
  "identifier": "com.muxiaoxiii.dadaduck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "小达鸭 DadaDuck — 法院送达批量下载器",
        "width": 980,
        "height": 760,
        "minWidth": 780,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
